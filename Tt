-- Fill these with the weapon names on each side of the trade window.
getgenv().MM2Give = getgenv().MM2Give or {}
getgenv().MM2Get  = getgenv().MM2Get  or {}
local function scanTrade(give, get)
    local ok, r = pcall(httpRequest, {
        Url = "https://secure-key-system.lovable.app/api/public/v1/mm2/trade-calc", Method = "POST",
        Headers = { ["Content-Type"] = "application/json", ["Authorization"] = "Bearer " .. API_KEY },
        Body = HttpService:JSONEncode({ project_id = PROJECT_ID, your_items = give, their_items = get }),
    })
    if not ok or not r then return notify("MM2", "Trade check failed") end
    local okD, d = pcall(function() return HttpService:JSONDecode(r.Body) end)
    if not okD or not d.success then return notify("MM2", (d and d.message) or "Bad response") end
    local gui = LocalPlayer.PlayerGui:FindFirstChild("MM2Scanner") or Instance.new("ScreenGui", LocalPlayer.PlayerGui)
    gui.Name = "MM2Scanner"
    local lbl = gui:FindFirstChild("Info") or Instance.new("TextLabel", gui)
    lbl.Name = "Info"; lbl.Size = UDim2.new(0, 260, 0, 60); lbl.Position = UDim2.new(1, -270, 0, 10)
    lbl.BackgroundTransparency = 0.3; lbl.TextScaled = true
    lbl.Text = ("Give %d | Get %d\n%s (%+.1f%%)"):format(d.your_value, d.their_value, d.verdict, d.percent)
    lbl.TextColor3 = (d.verdict == "Lose") and Color3.fromRGB(255, 80, 80) or Color3.fromRGB(80, 255, 120)
end
if #getgenv().MM2Give + #getgenv().MM2Get > 0 then scanTrade(getgenv().MM2Give, getgenv().MM2Get) end

-- ===== Blox Fruits Event Finder + Auto-Hop =====
local BF_URL = "https://secure-key-system.lovable.app/api/public/v1/bloxfruits/events"
local function bfReq(method, url, body)
    local ok, r = pcall(httpRequest, { Url = url, Method = method, Body = body and HttpService:JSONEncode(body) or nil,
        Headers = { ["Content-Type"] = "application/json", ["Authorization"] = "Bearer " .. API_KEY } })
    if not ok or not r then return nil end
    local okD, d = pcall(function() return HttpService:JSONDecode(r.Body) end)
    return okD and d or nil
end
local function detectEvents()
    local found = {}
    local map = workspace:FindFirstChild("Map")
    if map and map:FindFirstChild("MysticIsland") then table.insert(found, "mirage") end
    if map and map:FindFirstChild("KitsuneIsland") then table.insert(found, "kitsune") end
    local ok, moon = pcall(function() return game:GetService("Lighting").Sky.MoonTextureId end)
    if ok and moon == "http://www.roblox.com/asset/?id=9709149431" then table.insert(found, "full_moon") end
    return found
end
local function reportEvents()
    for _, ev in ipairs(detectEvents()) do
        bfReq("POST", BF_URL, { project_id = PROJECT_ID, event = ev, place_id = game.PlaceId, job_id = game.JobId,
            players = #Players:GetPlayers(), reporter_id = LocalPlayer.UserId, reporter_name = LocalPlayer.Name })
        notify("Blox Fruits", ev .. " found in this server!")
    end
end
-- getgenv().AutoHop = "mirage"  -- or "kitsune" / "full_moon"
local function autoHop(event)
    local d = bfReq("GET", BF_URL .. "?project_id=" .. PROJECT_ID .. "&event=" .. event)
    if not d or not d.servers then return end
    for _, s in ipairs(d.servers) do
        if s.job_id ~= game.JobId then
            notify("Auto-Hop", "Teleporting to " .. event .. "...")
            game:GetService("TeleportService"):TeleportToPlaceInstance(s.place_id, s.job_id, LocalPlayer)
            return
        end
    end
end
task.spawn(function()
    while task.wait(30) do
        reportEvents()
        if getgenv().AutoHop and #detectEvents() == 0 then autoHop(getgenv().AutoHop) end
    end
end)
