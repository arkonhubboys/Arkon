-- KeyForge key check
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local API_URL    = "https://secure-key-system.lovable.app/api/public/v1/verify"
local PROJECT_ID = "3c3a74de358542e7"
local API_KEY    = "ks_48c74b0e3da547d88d5e8ae31525d585fc5ef7c41ca5bedc"
local GET_KEY_URL = "https://secure-key-system.lovable.app/get/3c3a74de358542e7"

local Key = getgenv().Key or "USER_KEY" -- the key the user got from GET_KEY_URL

local httpRequest = (syn and syn.request) or (http and http.request) or http_request or request
local HWID = (gethwid and gethwid()) or game:GetService("RbxAnalyticsService"):GetClientId()

-- Detect executor (Synapse, Wave, Solara, Delta, Fluxus, ...)
local EXECUTOR = "unknown"
pcall(function()
    if identifyexecutor then EXECUTOR = tostring((identifyexecutor()))
    elseif getexecutorname then EXECUTOR = tostring(getexecutorname())
    elseif syn then EXECUTOR = "Synapse X"
    elseif fluxus then EXECUTOR = "Fluxus" end
end)

local function verifyKey(key)
    local ok, response = pcall(httpRequest, {
        Url = API_URL,
        Method = "POST",
        Headers = {
            ["Content-Type"] = "application/json",
            ["Authorization"] = "Bearer " .. API_KEY,
        },
        Body = HttpService:JSONEncode({
            project_id = PROJECT_ID,
            key = key,
            hwid = HWID,
            roblox_user_id = LocalPlayer.UserId,
            roblox_username = LocalPlayer.Name,
            executor = EXECUTOR,
            roblox_avatar = "https://www.roblox.com/headshot-thumbnail/image?userId=" .. LocalPlayer.UserId .. "&width=150&height=150&format=png",
        }),
    })
    if not ok or not response then
        return false, "Could not reach key server"
    end
    local decoded = pcall(function() response = HttpService:JSONDecode(response.Body) end)
    if not decoded then
        return false, "Invalid server response"
    end
    return response.valid == true, response.message, response
end

local valid, message, info = verifyKey(Key)
-- Kill-switch / maintenance / blocked executor
if info and info.status == "killed" then
    LocalPlayer:Kick("⛔ " .. tostring(info.message))
    return
elseif info and info.status == "maintenance" then
    local m = tostring(info.message)
    if info.maintenance_until then m = m .. "
Back at: " .. tostring(info.maintenance_until) .. " (UTC)" end
    LocalPlayer:Kick("🛠 Maintenance: " .. m)
    return
elseif info and info.status == "executor_blocked" then
    LocalPlayer:Kick("🚫 " .. tostring(info.message))
    return
end

-- 🎁 Promo codes: getgenv().Promo = "CODE" to get a free key (or extend Key)
if not valid and getgenv().Promo then
    local okP, r = pcall(httpRequest, {
        Url = "https://secure-key-system.lovable.app/api/public/v1/redeem", Method = "POST",
        Headers = { ["Content-Type"] = "application/json", ["Authorization"] = "Bearer " .. API_KEY },
        Body = HttpService:JSONEncode({ project_id = PROJECT_ID, code = getgenv().Promo, key = Key }),
    })
    if okP and r then
        local okD, d = pcall(function() return HttpService:JSONDecode(r.Body) end)
        if okD and d.success then
            Key = d.key
            if setclipboard then setclipboard(d.key) end
            valid, message, info = verifyKey(Key)
        end
    end
end

if not valid then
    if setclipboard then setclipboard(GET_KEY_URL) end
    Players.LocalPlayer:Kick("Key rejected: " .. tostring(message) .. "\nGet a key: " .. GET_KEY_URL)
    return
end

print("[KeyForge] " .. message)
