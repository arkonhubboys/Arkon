-- 💬 Support messages: send a message and receive replies (owner or AI)
local MSG_URL = "https://secure-key-system.lovable.app/api/public/v1/messages"
local lastSeen = nil
local primed = false

-- On-screen notification popup
local function notify(title, text)
    local gui = LocalPlayer:WaitForChild("PlayerGui"):FindFirstChild("SupportNotify")
    if not gui then
        gui = Instance.new("ScreenGui")
        gui.Name = "SupportNotify"
        gui.ResetOnSpawn = false
        gui.Parent = LocalPlayer.PlayerGui
        local list = Instance.new("Frame")
        list.Name = "List"
        list.BackgroundTransparency = 1
        list.Size = UDim2.new(0, 320, 1, -20)
        list.Position = UDim2.new(1, -330, 0, 10)
        list.Parent = gui
        local layout = Instance.new("UIListLayout")
        layout.Padding = UDim.new(0, 6)
        layout.VerticalAlignment = Enum.VerticalAlignment.Bottom
        layout.Parent = list
    end
    local card = Instance.new("TextButton")
    card.AutoButtonColor = false
    card.Size = UDim2.new(1, 0, 0, 0)
    card.AutomaticSize = Enum.AutomaticSize.Y
    card.BackgroundColor3 = Color3.fromRGB(20, 24, 28)
    card.TextColor3 = Color3.fromRGB(235, 240, 240)
    card.TextWrapped = true
    card.TextXAlignment = Enum.TextXAlignment.Left
    card.Font = Enum.Font.Gotham
    card.TextSize = 14
    card.RichText = true
    card.Text = "<b>" .. title .. "</b>\n" .. text:gsub("<", "&lt;")
    Instance.new("UICorner", card).CornerRadius = UDim.new(0, 8)
    local pad = Instance.new("UIPadding", card)
    pad.PaddingTop, pad.PaddingBottom = UDim.new(0, 10), UDim.new(0, 10)
    pad.PaddingLeft, pad.PaddingRight = UDim.new(0, 12), UDim.new(0, 12)
    local stroke = Instance.new("UIStroke", card)
    stroke.Color = Color3.fromRGB(0, 220, 150)
    card.Parent = gui.List
    card.MouseButton1Click:Connect(function() card:Destroy() end)
    task.delay(15, function() if card then card:Destroy() end end)
end

local function decode(res)
    if not res then return nil, "no response" end
    local okJ, data = pcall(function() return HttpService:JSONDecode(res.Body) end)
    if not okJ then return nil, "bad JSON (HTTP " .. tostring(res.StatusCode) .. "): " .. tostring(res.Body) end
    if res.StatusCode and res.StatusCode >= 400 then
        return nil, "HTTP " .. res.StatusCode .. ": " .. tostring(data.message)
    end
    return data
end

local function label(sender)
    if sender == "owner" then return "Owner" elseif sender == "ai" then return "AI Support" end
    return nil
end

local function sendSupport(text)
    local ok, res = pcall(httpRequest, {
        Url = MSG_URL, Method = "POST",
        Headers = { ["Content-Type"] = "application/json", ["Authorization"] = "Bearer " .. API_KEY },
        Body = HttpService:JSONEncode({
            project_id = PROJECT_ID,
            player_user_id = LocalPlayer.UserId,
            player_name = LocalPlayer.Name,
            message = text,
        }),
    })
    if not ok then warn("[Support] request failed: " .. tostring(res)) return end
    local data, err = decode(res)
    if not data then warn("[Support] " .. err) notify("Support", err) return end
    -- replies (welcome/AI) will also arrive through pollReplies
end

local function pollReplies()
    local url = MSG_URL .. "?project_id=" .. PROJECT_ID .. "&player_user_id=" .. LocalPlayer.UserId
    if lastSeen then url = url .. "&since=" .. HttpService:UrlEncode(lastSeen) end
    local ok, res = pcall(httpRequest, { Url = url, Method = "GET", Headers = { ["Authorization"] = "Bearer " .. API_KEY } })
    if not ok then warn("[Support] poll failed: " .. tostring(res)) return end
    local data, err = decode(res)
    if not data then warn("[Support] " .. err) return end
    for _, m in ipairs(data.messages or {}) do
        lastSeen = m.created_at
        local who = label(m.sender)
        if who and primed then
            print("[" .. who .. "] " .. m.message)
            notify(who, m.message)
        end
    end
    primed = true -- first poll only loads history (no popups)
end

-- Example: sendSupport("Hi, my key is not working")
pollReplies()
task.spawn(function() while task.wait(5) do pollReplies() end end)

-- ============ 💬 Player-to-Player Chat ============
local CHAT_URL = (MSG_URL:gsub("/messages$", "")) .. "/chat"
local lastChatId = nil

-- toUserId = nil sends to the global room; a UserId sends a private message
local function sendMessage(toUserId, message)
    local ok, res = pcall(httpRequest, {
        Url = CHAT_URL .. "/send", Method = "POST",
        Headers = { ["Content-Type"] = "application/json", ["Authorization"] = "Bearer " .. API_KEY },
        Body = HttpService:JSONEncode({
            project_id = PROJECT_ID, key = Key,
            from_user_id = LocalPlayer.UserId, from_username = LocalPlayer.Name,
            to_user_id = toUserId, message = message,
        }),
    })
    if not ok then warn("[Chat] send failed: " .. tostring(res)) return false end
    local data, err = decode(res)
    if not data then notify("Chat", err) return false end
    return true
end

local function getNewMessages()
    local url = CHAT_URL .. "/messages?project_id=" .. PROJECT_ID .. "&user_id=" .. LocalPlayer.UserId
        .. "&key=" .. HttpService:UrlEncode(Key)
    if lastChatId then url = url .. "&last_message_id=" .. lastChatId end
    local ok, res = pcall(httpRequest, { Url = url, Method = "GET", Headers = { ["Authorization"] = "Bearer " .. API_KEY } })
    if not ok then return end
    local data = decode(res)
    if not data then return end
    local first = lastChatId == nil
    for _, m in ipairs(data.messages or {}) do
        if not first and m.from_user_id ~= LocalPlayer.UserId then
            local tag = m.to_user_id and "[DM] " or "[Chat] "
            print(tag .. m.from_username .. ": " .. m.message)
            notify(tag .. m.from_username, m.message)
        end
    end
    lastChatId = data.last_message_id
end

-- Example:
--   Player A: sendMessage(nil, "hello everyone")         -- global room
--   Player A: sendMessage(123456789, "hey, you there?")  -- private to player B
--   Player B receives it via getNewMessages() and replies:
--             sendMessage(<Player A UserId>, "yes!")     -- arrives back at A
getNewMessages()
task.spawn(function() while task.wait(2) do getNewMessages() end end)

